# ===== App =====
APP_ENV=dev                 # dev | prod
APP_DEBUG=true
APP_NAME=shopkb
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ===== Database =====
# 本地无 Docker 默认 SQLite；生产/Docker 用 MySQL
DATABASE_URL=sqlite+aiosqlite:///./data/shopkb.db
# DATABASE_URL=mysql+asyncmy://shopkb:shopkb@localhost:3306/shopkb?charset=utf8mb4

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
# 本地无 Docker 默认 Milvus Lite（嵌入式文件）；生产/Docker 用 Standalone
# 注意：不能用 MILVUS_URI 命名（pymilvus 全局环境变量冲突）
VECTORSTORE_URI=./data/milvus_lite.db
# VECTORSTORE_URI=http://localhost:19530
# Zilliz Cloud（免费实例即可做混合检索实验，见 eval/hybrid_compare.py）
# VECTORSTORE_URI=https://in03-xxxxxxxxxxxx.serverless.<region>.cloud.zilliz.com
# token 必须叫 VECTORSTORE_TOKEN，不能叫 MILVUS_TOKEN —— pymilvus 会直接读环境变量（见 BAD_CASES #2）
VECTORSTORE_TOKEN=
MILVUS_COLLECTION=product_kb
MILVUS_DIM=1024

# ===== LLM (DeepSeek) =====
LLM_MODEL=deepseek-chat     # deepseek-chat 或 deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# ===== Embedding (DashScope) =====
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ===== Reranker =====
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Auth =====
JWT_SECRET=change-me-to-a-32-byte-random-hex
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== Storage =====
UPLOAD_DIR=./data/uploads

# ===== Observability (optional) =====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
